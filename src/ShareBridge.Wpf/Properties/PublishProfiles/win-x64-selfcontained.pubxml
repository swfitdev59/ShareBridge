<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-contained, single-file publish: bundles the .NET 9 runtime so the app runs on a
  clean Windows machine with nothing installed. Produces one ShareBridge.exe.

  Publish with:
    dotnet publish src/ShareBridge.Wpf/ShareBridge.Wpf.csproj -p:PublishProfile=win-x64-selfcontained
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>..\..\publish\win-x64\</PublishDir>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Trimming is unsafe for WPF (reflection/XAML), so it stays off. -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- No debug symbols in the distributable. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
