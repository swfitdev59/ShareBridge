<Window x:Class="ShareBridge.Wpf.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShareBridge settings"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI">

    <StackPanel Margin="22">

        <TextBlock Text="YOUR IDENTITY" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
        <TextBlock Text="Display name" Style="{StaticResource DimText}" Margin="0,0,0,4" />
        <TextBox x:Name="DisplayNameBox" Style="{StaticResource AppTextBox}" />
        <TextBlock Text="This is what other people on the network see."
                   Style="{StaticResource DimText}" FontSize="11" Margin="2,5,0,0" />

        <TextBlock Text="RECEIVING" Style="{StaticResource SectionLabel}" Margin="0,22,0,8" />
        <TextBlock Text="Save incoming files to" Style="{StaticResource DimText}" Margin="0,0,0,4" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="DownloadFolderBox" Grid.Column="0" Style="{StaticResource AppTextBox}" />
            <Button Grid.Column="1" Content="Browse…" Style="{StaticResource GhostButton}"
                    Margin="8,0,0,0" Click="OnBrowse" />
        </Grid>
        <TextBlock Text="Each sender gets their own subfolder."
                   Style="{StaticResource DimText}" FontSize="11" Margin="2,5,0,0" />

        <CheckBox x:Name="AutoAcceptBox" Style="{StaticResource AppCheckBox}" Margin="0,14,0,0"
                  Content="Accept incoming files automatically (no prompt)" />

        <TextBlock Text="NOTIFICATIONS" Style="{StaticResource SectionLabel}" Margin="0,22,0,8" />
        <CheckBox x:Name="NotificationsBox" Style="{StaticResource AppCheckBox}"
                  Content="Show a desktop notification for new messages" />
        <TextBlock Text="Shown only when you are not already viewing that conversation."
                   Style="{StaticResource DimText}" FontSize="11" Margin="2,6,0,0" />

        <TextBlock Text="SYSTEM TRAY" Style="{StaticResource SectionLabel}" Margin="0,22,0,8" />
        <CheckBox x:Name="MinimizeToTrayBox" Style="{StaticResource AppCheckBox}"
                  Content="Minimize to the system tray" />
        <CheckBox x:Name="CloseToTrayBox" Style="{StaticResource AppCheckBox}" Margin="0,10,0,0"
                  Content="Keep running in the tray when the window is closed" />
        <TextBlock Text="Right-click the tray icon and choose Exit to quit completely."
                   Style="{StaticResource DimText}" FontSize="11" Margin="2,6,0,0" />

        <TextBlock Text="CHAT HISTORY" Style="{StaticResource SectionLabel}" Margin="0,22,0,8" />
        <CheckBox x:Name="SaveHistoryBox" Style="{StaticResource AppCheckBox}"
                  Content="Save conversations so they reopen after a restart" />
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Open history folder" Style="{StaticResource GhostButton}"
                    Click="OnOpenHistory" Margin="0,0,8,0" />
            <Button Content="Clear all history" Style="{StaticResource DangerButton}"
                    Padding="14,7" Click="OnClearHistory" />
        </StackPanel>
        <TextBlock Text="Conversations are stored only on this PC, never on a server."
                   Style="{StaticResource DimText}" FontSize="11" Margin="2,6,0,0" />

        <TextBlock Text="NETWORK" Style="{StaticResource SectionLabel}" Margin="0,22,0,8" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Discovery port (UDP)" Style="{StaticResource DimText}" Margin="0,0,0,4" />
                <TextBox x:Name="DiscoveryPortBox" Style="{StaticResource AppTextBox}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Transfer port (TCP)" Style="{StaticResource DimText}" Margin="0,0,0,4" />
                <TextBox x:Name="TransferPortBox" Style="{StaticResource AppTextBox}" />
            </StackPanel>
        </Grid>
        <TextBlock Text="Every machine must use the same discovery port. Port changes take effect after a restart."
                   Style="{StaticResource DimText}" FontSize="11" TextWrapping="Wrap" Margin="2,5,0,0" />

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}"
                   FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0"
                   Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Cancel" Style="{StaticResource GhostButton}" MinWidth="88"
                    IsCancel="True" Margin="0,0,8,0" />
            <Button Content="Save" Style="{StaticResource PrimaryButton}" MinWidth="88"
                    IsDefault="True" Click="OnSave" />
        </StackPanel>
    </StackPanel>
</Window>
