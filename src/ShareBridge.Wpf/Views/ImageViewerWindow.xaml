<Window x:Class="ShareBridge.Wpf.Views.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Picture"
        Height="640" Width="900"
        MinHeight="320" MinWidth="580"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI"
        PreviewKeyDown="OnPreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The picture is shown at its own size at most: blowing a small screenshot up to
             fill the window would only make it mushy. -->
        <Image Grid.Row="0" x:Name="Picture"
               Margin="14"
               Stretch="Uniform"
               StretchDirection="DownOnly"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="16,10">
            <!-- Two columns: the name gets whatever the buttons leave and trims, rather
                 than running underneath them. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock x:Name="NameText" Style="{StaticResource TitleText}" FontSize="13"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DetailText" Style="{StaticResource DimText}" FontSize="11"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Copy" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                            Click="OnCopy" ToolTip="Copy the picture to the clipboard" />
                    <Button Content="Save as…" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                            Click="OnSave" />
                    <Button Content="Show in folder" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                            Click="OnShowInFolder" />
                    <!-- The viewer is not a dialog, so IsCancel would do nothing here. -->
                    <Button Content="Close" Style="{StaticResource PrimaryButton}" MinWidth="80"
                            Click="OnClose" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
